  "run_order": "separate, shared, shortcut_a, no_shortcut_a, no_shortcut_b, shortcut_b. Adjacent runs compare builds. Before each run a 15-second CPU check waited for an idle machine. An earlier first run of the shared build is omitted: its core suite ran about 15% slower than every later run of the same binary.",
  "commands": {
    "core": "cargo bench -p intervals-core --bench max_weight_with_capacity --locked",
    "profile_core": "cargo bench -p intervals-core --bench max_weight_with_capacity_profile --locked",
    "polars": "uv run --no-sync python benchmarks/capacity_temporal.py",
    "profile_polars": "uv run --no-sync python benchmarks/capacity_profile_temporal.py",
    "plugin": "uv sync --locked --reinstall-package polars-intervals --config-setting \"build-args=--profile release\"",
    "verification": "benchmarks/provenance.py verify_release and environment, before each built run",
    "repeats": "Runs other than shared use the saved release benchmark executables and plugin of each build, with the plugin hash recorded in repeat_runs."
  },
